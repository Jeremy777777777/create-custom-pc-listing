{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scoped PC research ledger v1",
  "type": "object",
  "required": ["schemaVersion", "productId", "configurationId", "facts", "fields"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "candidate_coverage_version": {"enum": [1, 2]},
    "productId": {"type": "string", "pattern": "\\S"},
    "configurationId": {"type": "string", "pattern": "\\S"},
    "fcc_management": {"const": "ERP_INVENTORY", "description": "New listing ledgers delegate FCC lookup to an explicit private task and ERP Listing Inventory."},
    "serial_research": {"$ref": "#/$defs/serialResearch"},
    "amazon_selection": {"$ref": "#/$defs/amazonSelection"},
    "facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
    "fields": {"type": "array", "items": {"$ref": "#/$defs/field"}}
  },
  "$defs": {
    "amazonSelection": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "catalogSha256", "context", "fields"],
      "properties": {
        "schemaVersion": {"const": 1},
        "catalogSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "catalogReference": {"$ref": "#/$defs/text"},
        "context": {
          "type": "object", "additionalProperties": false,
          "required": ["marketplaceId", "locale", "productType", "itemTypeKeyword"],
          "properties": {
            "marketplaceId": {"$ref": "#/$defs/text"},
            "locale": {"$ref": "#/$defs/text"},
            "productType": {"$ref": "#/$defs/text"},
            "itemTypeKeyword": {"$ref": "#/$defs/text"}
          }
        },
        "fields": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false,
            "required": ["sheet", "attribute", "decision"],
            "properties": {
              "sheet": {"$ref": "#/$defs/text"}, "attribute": {"$ref": "#/$defs/text"},
              "path": {"$ref": "#/$defs/text"},
              "decision": {"enum": ["DIRECT", "APPROXIMATE", "UNOBSERVED"]},
              "reason": {"$ref": "#/$defs/text"}, "differences": {"$ref": "#/$defs/text"},
              "missingConfirmation": {"$ref": "#/$defs/text"},
              "referenceOptionCode": {"$ref": "#/$defs/text"},
              "members": {"type": "object", "additionalProperties": false,
                "properties": {
                  "value": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/value"}},
                  "value_candidate": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/value"}}
                }}
            }
          }
        }
      }
    },
    "serialResearch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow_mode", "outcome", "reason", "sources_attempted", "units", "resolved_fact_ids", "factory_sold_differences", "unresolved_fields", "reconciliation"],
      "properties": {
        "workflow_mode": {"enum": ["FULL_LISTING_WORKFLOW", "IMAGE_ONLY_WORKFLOW", "IMAGE_ADJUSTMENT_WORKFLOW"]},
        "outcome": {"enum": ["COMPLETED", "ERP_TARGET_NOT_FOUND", "SERIAL_NOT_FOUND", "ERP_UNAVAILABLE", "OEM_UNAVAILABLE", "OEM_NO_BOM", "NOT_REQUIRED", "NOT_ASSESSED_LEGACY"]},
        "reason": {"type": "string", "pattern": "\\S"},
        "reviewed_date": {"type": "string"},
        "next_action": {"type": "string", "pattern": "\\S"},
        "owner": {"type": "string", "pattern": "\\S"},
        "sources_attempted": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "\\S"}},
        "resolved_fact_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "\\S"}},
        "factory_sold_differences": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "\\S"}},
        "unresolved_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "\\S"}},
        "reconciliation": {"type": "string"},
        "units": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["unit_evidence_alias", "serial_source_kind", "erp_record_reference", "target_configuration", "batch_match_basis", "returned_model", "oem_configuration_source", "fact_ids"],
            "properties": {
              "unit_evidence_alias": {"type": "string", "pattern": "^UNIT-[A-Z0-9-]+$"},
              "serial_source_kind": {"enum": ["CURRENT", "HISTORICAL", "USER_SUPPLIED"]},
              "erp_record_reference": {"type": "string", "pattern": "\\S"},
              "target_configuration": {"type": "string", "pattern": "\\S"},
              "batch_match_basis": {"type": "string", "pattern": "\\S"},
              "returned_model": {"type": "string", "pattern": "\\S"},
              "oem_configuration_source": {"type": "string", "pattern": "\\S"},
              "fact_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "\\S"}}
            }
          }
        }
      }
    },
    "value": {"type": ["string", "number", "boolean", "null"]},
    "text": {"type": "string", "pattern": "\\S"},
    "fact": {
      "type": "object",
      "required": ["id", "sheet", "attribute", "configurationId", "fact_scope", "status", "final_value", "source"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "sheet": {"$ref": "#/$defs/text"},
        "attribute": {"$ref": "#/$defs/text"},
        "configurationId": {"$ref": "#/$defs/text"},
        "fact_scope": {"enum": ["FACTORY", "CURRENT_UNIT", "SOLD_BASE", "PLATFORM_CAPABILITY"]},
        "status": {"enum": ["VERIFIED", "INPUT_UNVERIFIED", "CONFLICT", "TBD", "SOURCE_UNAVAILABLE", "NOT_APPLICABLE"]},
        "final_value": {"$ref": "#/$defs/value"},
        "source": {"$ref": "#/$defs/text"},
        "recommended_candidate": {"$ref": "#/$defs/value"},
        "value_candidate": {"type": ["string", "number", "boolean"]},
        "value_candidate_source": {"$ref": "#/$defs/text"},
        "transfer_basis": {"$ref": "#/$defs/text"},
        "applies_to_sold_configuration": {"type": "boolean"},
        "evidence_scope": {"enum": ["HOST", "RADIO_MODULE", "UNRESOLVED"]},
        "authorization_route": {"enum": ["SDoC", "certification", "unresolved"]},
        "evidence": {
          "type": "object",
          "description": "Sanitized unit/part/source/review metadata; private serials must not be published. New FCC workbook generation requires lookup_outcome and the matching evidence contract in fcc-research-workflow.md.",
          "properties": {
            "lookup_outcome": {"enum": ["UNIT_CONFIRMED", "MODEL_MODULE_MATCH", "SUPPORTED_OPTION_SELECTED", "PENDING", "FACTORY_NO_WLAN", "HOST_SDOC"]}
          }
        }
      }
    },
    "field": {
      "type": "object",
      "required": ["sheet", "attribute", "selected_fact"],
      "additionalProperties": false,
      "properties": {
        "sheet": {"$ref": "#/$defs/text"},
        "attribute": {"$ref": "#/$defs/text"},
        "selected_fact": {"$ref": "#/$defs/text"}
      }
    }
  }
}
